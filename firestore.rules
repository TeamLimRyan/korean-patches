rules_version = '2';

// 임라이언 번역방 방명록 규칙
//
// 글쓰기는 로그인 없이 누구나. 대신 넣을 수 있는 필드와 길이를 엄격히 제한해
// 낙서용으로 쓰이지 않게 막는다.
// 삭제는 아래 ownerUid() 계정, 즉 GitHub 로그인한 주인만 할 수 있다.
// 수정은 아무도 할 수 없다.
//
// 적용: Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 붙여넣고 게시.
//
// ⚠ ownerUid() 값 채우는 법
//   1. 사이트 방명록에서 "관리자 로그인"을 눌러 GitHub 계정으로 로그인한다.
//   2. 아직 주인으로 등록되지 않았으므로 화면에 이 계정의 UID가 표시된다.
//   3. 그 값을 아래 ownerUid() 와 assets/firebase-config.js 의 OWNER_UID 양쪽에 넣는다.
//
//   UID가 아니라 이메일로 막지 않는 이유는, GitHub 계정은 이메일을 비공개로 둘 수 있어
//   토큰에 이메일이 안 실리는 경우가 있기 때문이다. UID는 항상 있다.

service cloud.firestore {
  match /databases/{database}/documents {

    function ownerUid() {
      return 'PASTE_OWNER_UID_HERE';
    }

    function isOwner() {
      return request.auth != null && request.auth.uid == ownerUid();
    }

    match /guestbook/{entry} {

      allow read: if true;

      allow create: if
        // 정확히 이 세 필드만. 방문자 정보는 아무것도 받지 않는다.
        request.resource.data.keys().hasOnly(['name', 'message', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'message', 'createdAt'])

        // 닉네임: 1~20자
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20

        // 본문: 1~500자
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 500

        // 작성 시각은 서버 시각이어야 한다. 클라이언트가 임의 시각을 못 넣는다.
        && request.resource.data.createdAt == request.time;

      // 지우는 건 주인만.
      allow delete: if isOwner();

      // 남의 글을 고쳐 쓰는 일은 아무도 못 한다.
      allow update: if false;
    }

    // 그 밖의 모든 경로는 차단.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
